package lnbits:extension;

interface host {
  record storage-get-request { table: string, id: string }
  record storage-get-response { data-json: option<string> }
  record storage-set-request { table: string, data-json: string }
  record storage-set-response { ok: bool }
  record storage-paginated-request {
    table: string, filters-json: string, search: string, search-fields: list<string>,
    sort-by: string, descending: bool, limit: u32, offset: u32
  }
  record storage-paginated-response { rows-json: string, total: u64 }
  record invoice-public-request {
    source-id: string, amount: f64, currency: string, memo: string,
    extra: list<tuple<string,string>>,
    description-hash: option<string>, unhashed-description: option<string>
  }
  record invoice-response { payment-hash: string, payment-request: string, checking-id: string }
  record invoice-status-request { payment-hash: string, source-id: string }
  record invoice-status-response { paid: bool, pending: bool, failed: bool, amount-msat: s64 }
  record refresh-payment-request { wallet-id: string, checking-id: string }
  record refresh-payment-response { checking-id: string, payment-hash: string, status: string, amount-msat: u64, fee-msat: u64, pending: bool, success: bool }
  record fiat-invoice-request { source-id: string, amount: f64, currency: string, memo: string }
  record fiat-invoice-response { payment-hash: string, payment-request: string, amount-msat: s64, fiat-provider: string }
  record providers-response { providers: list<string> }
  record user-wallet { id: string, name: string, currency: option<string>, wallet-type: string, onchain-network: option<string>, receiving-ready: bool }
  record wallets-request { wallet-type: option<string> }
  record wallets-response { wallets: list<user-wallet> }
  record pay-invoice-request {
    wallet-id: string, payment-request: string, max-sat: option<u64>,
    description: string, extra: list<tuple<string,string>>
  }
  record pay-lnurl-request {
    wallet-id: string, lnurl: string, amount: f64, currency: string,
    comment: option<string>, description: string, max-sat: option<u64>,
    extra: list<tuple<string,string>>, fetch-only: bool
  }
  record pay-response {
    ok: bool, error: option<string>, checking-id: option<string>, payment-hash: option<string>,
    status: option<string>, amount-msat: u64, fee-msat: u64, pending: bool, success: bool,
    payment-request: option<string>
  }
  record publish-request { item-id: string, data-json: string }
  record publish-response { sent: bool }
  record random-id-request { prefix: string }
  record random-id-response { id: string }
  record now-response { timestamp: u64 }
  storage-get: func(request: storage-get-request) -> storage-get-response;
  storage-set: func(request: storage-set-request) -> storage-set-response;
  storage-get-paginated: func(request: storage-paginated-request) -> storage-paginated-response;
  create-invoice-public: func(request: invoice-public-request) -> invoice-response;
  invoice-status: func(request: invoice-status-request) -> invoice-status-response;
  refresh-payment: func(request: refresh-payment-request) -> refresh-payment-response;
  create-fiat-invoice-public: func(request: fiat-invoice-request) -> fiat-invoice-response;
  list-fiat-providers: func() -> providers-response;
  list-user-wallets: func(request: wallets-request) -> wallets-response;
  pay-invoice: func(request: pay-invoice-request) -> pay-response;
  pay-lnurl: func(request: pay-lnurl-request) -> pay-response;
  websocket-publish: func(request: publish-request) -> publish-response;
  random-id: func(request: random-id-request) -> random-id-response;
  now: func() -> now-response;
}

interface utils-currencies {
  record currencies-response { currencies: list<string> }
  record rate-request { currency: string }
  record rate-response { rate: f64, price: f64 }
  list-currencies: func() -> currencies-response;
  rate: func(request: rate-request) -> rate-response;
}

interface onchain {
  record reserve-public-request { table: string, source-id: string, checkout-id: string }
  record reserve-response { address: string, network: string, status-token: string }
  record status-request { wallet-id: string, source-id: string, checkout-id: string, address: string, status-token: option<string> }
  record status-response { received-sat: u64, confirmed-sat: u64, unconfirmed-sat: u64, checked-at: u64 }
  reserve-address-public: func(request: reserve-public-request) -> reserve-response;
  payment-status: func(request: status-request) -> status-response;
}

world pos {
  import host;
  import utils-currencies;
  import onchain;
  export metadata: func(request-json: string) -> string;
  export list-terminals: func(request-json: string) -> string;
  export terminal-settings: func(request-json: string) -> string;
  export save-terminal: func(request-json: string) -> string;
  export disable-terminal: func(request-json: string) -> string;
  export rotate-links: func(request-json: string) -> string;
  export get-terminal: func(request-json: string) -> string;
  export create-checkout: func(request-json: string) -> string;
  export checkout-status: func(request-json: string) -> string;
  export public-history: func(request-json: string) -> string;
  export sales: func(request-json: string) -> string;
  export reconcile: func(request-json: string) -> string;
  export record-payment: func(request-json: string) -> string;
}
